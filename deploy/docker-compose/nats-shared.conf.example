server_name: studio-infra
http_port: 8222
jetstream {
  store_dir: /data
  max_memory_store: 256MB
  # Each worktree reserves a 4 GiB output stream, plus KV storage.
  max_file_store: 16GB
}
accounts {
  branch_a {
    jetstream: enabled
    users: [{user: branch_a, password: change-me-a}]
  }
  branch_b {
    jetstream: enabled
    users: [{user: branch_b, password: change-me-b}]
  }
}
