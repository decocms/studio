FROM oven/bun:1.3.14-slim AS bun
FROM node:24-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/bindings/package.json ./packages/bindings/
COPY packages/create-deco/package.json ./packages/create-deco/
COPY packages/e2e/package.json ./packages/e2e/
COPY packages/harness-runner/package.json ./packages/harness-runner/
COPY packages/mcp-utils/package.json ./packages/mcp-utils/
COPY packages/runtime/package.json ./packages/runtime/
COPY packages/sandbox-controller/package.json ./packages/sandbox-controller/
COPY packages/sandbox/package.json ./packages/sandbox/
COPY packages/shared/package.json ./packages/shared/
COPY packages/typegen/package.json ./packages/typegen/
COPY packages/ui/package.json ./packages/ui/
RUN --mount=type=cache,target=/root/.bun/install/cache bun install --frozen-lockfile
COPY . .
RUN bun run --cwd=packages/sandbox build
ENV NODE_ENV=development
