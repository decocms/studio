{
  "jsPlugins": [
    "./plugins/enforce-kebab-case-file-names.js",
    "./plugins/enforce-query-key-constants.js",
    "./plugins/ban-use-effect.js",
    "./plugins/ban-memoization.js",
    "./plugins/require-cn-classname.js",
    "./plugins/ban-direct-auth-client-organization.js",
    "./plugins/ban-ref-current-assignment.js",
    "./plugins/ban-cross-tree-imports.js",
    "./plugins/ban-e2e-app-imports.js",
    "./plugins/ban-web-server-imports.js",
    "./plugins/ban-git-provider-reachthrough.js",
    "./plugins/ensure-tailwind-design-system-tokens.js"
  ],
  "ignorePatterns": ["apps/docs/*"],
  "rules": {
    "unicorn/no-useless-fallback-in-spread": "off",
    "no-unused-expressions": "off",
    "no-explicit-any": "warn",
    "eslint/no-control-regex": "error",
    "eslint/no-unsafe-optional-chaining": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none",
        "ignoreRestSiblings": true
      }
    ],
    "eslint/no-useless-escape": "error",
    "eslint/require-yield": "error",
    // --- React Compiler rules (oxlint's built-in `react` plugin) ---
    //
    // The five below are OFF on purpose. Each one flags a pattern this repo
    // adopted deliberately, or cannot see enough to judge — leaving them on
    // would mean ~181 disable comments restating a justification that already
    // sits on the neighbouring line. Do not flip one back on without also
    // making the case for the pattern it bans.
    //
    // `refs`: 148 hits, 93 of which already carry an explicit
    //   `oxlint-disable ban-ref-current-assignment -- <reason>`. Reading a
    //   callback off a ref during render is how a hook stays subscribed across
    //   re-renders WITHOUT useEffect, which this repo bans; see
    //   hooks/use-task-board-events.ts, the reference implementation AGENTS.md
    //   points at for push-events. `ban-ref-current-assignment` already guards
    //   the case that is actually a bug (render-time access in a component
    //   body) and stays at "error".
    "react/refs": "off",
    // `immutability`: module-scope objects written during render — the bridge
    //   that hands server-originated copy to non-React call sites
    //   (providers/providers.tsx). Same useEffect-ban root cause.
    "react/immutability": "off",
    // `incompatible-library`: react-hook-form's `useForm().watch()`. The
    //   diagnostic says it outright — the API "cannot be memoized safely". Not
    //   fixable in our code at all, only by dropping the library.
    "react/incompatible-library": "off",
    // `static-components`: false positive on registry lookups
    //   (`const Icon = getIconComponent(name)` then `<Icon />`). The rule sees
    //   a component-valued expression in render and cannot tell it came from a
    //   stable table rather than a fresh definition.
    "react/static-components": "off",
    // `globals`: module-level run-once latches (posthog init, one-shot
    //   analytics events). Same useEffect-ban root cause.
    "react/globals": "off",
    //
    // The three below are enforced. Their findings were real and are fixed;
    // the handful of sites that legitimately cannot comply carry a scoped
    // disable naming the reason (a subscription lifecycle whose setState IS
    // the payload, or a rule that does not narrow to the render phase).
    "react/purity": "error",
    "react/set-state-in-effect": "error",
    "react-hooks/exhaustive-deps": "error",
    "enforce-kebab-case-file-names/kebab-case": "warn",
    "ban-types": "warn",
    "enforce-query-key-constants/enforce-query-key-constants": "warn",
    "ban-use-effect/ban-use-effect": "error",
    "ban-memoization/ban-memoization": "error",
    "require-cn-classname/require-cn-classname": "error",
    "ban-direct-auth-client-organization/ban-direct-auth-client-organization": "error",
    "ban-ref-current-assignment/ban-ref-current-assignment": "error",
    "ban-cross-tree-imports/ban-cross-tree-imports": "warn",
    "ban-e2e-app-imports/ban-e2e-app-imports": "error",
    "ban-web-server-imports/ban-web-server-imports": "warn",
    "ban-git-provider-reachthrough/ban-git-provider-reachthrough": "error",
    "ensure-tailwind-design-system-tokens/ensure-tailwind-design-system-tokens": "error"
  },
  "plugins": ["react"]
}
