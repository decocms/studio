{
  "name": "@decocms/e2e",
  "version": "1.69.4",
  "private": true,
  "description": "Black-box e2e suite (HTTP + DB) for Studio, isolated from app source.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:github-connect": "PORT=3001 VITE_PORT=4001 BASE_URL=http://localhost:4001 playwright test --config=playwright.github-connect.config.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@decocms/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@playwright/test": "^1.58.2",
    "pg": "^8.16.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/pg": "^8.15.6",
    "typescript": "^7.0.2"
  }
}
