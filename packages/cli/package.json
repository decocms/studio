{
  "name": "@decocms/cli",
  "version": "0.1.0",
  "description": "The decocms command (login, orgs, tools, api, typegen) and the typed Studio client runtime",
  "license": "MIT",
  "type": "module",
  "bin": {
    "decocms": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.6.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/decocms/studio",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  }
}
