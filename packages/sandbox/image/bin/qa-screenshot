#!/usr/bin/env node
/**
 * qa-screenshot — capture a page screenshot from inside the sandbox.
 *
 * The sandbox-hosted claude-code harness has no Decopilot `take_screenshot`
 * built-in, so this is its equivalent: headless Chromium via playwright-core,
 * both baked into the image. Unlike the hosted tool it can also reach the
 * sandbox's OWN dev server on localhost, which is the reason a browser lives
 * here at all.
 *
 * Usage:
 *   qa-screenshot <url> <outfile> [--mobile] [--full] [--selector=<css>]
 *                [--console] [--flutter] [--label=<text>]
 *
 * Default framing is the top viewport. `--full` captures the whole scrollable
 * page (clipped at a height ceiling). `--selector=<css>` captures just that one
 * element (scrolled into view) — a focused before/after of the affected
 * component instead of the whole page.
 *
 * `--mobile` emulates a phone: viewport, touch, AND the user-agent — many sites
 * pick their layout from the UA server-side, so a narrowed desktop returns
 * desktop markup and a plausible but WRONG "mobile" shot. Playwright's
 * `userAgent` sets both the request header and `navigator.userAgent`, so
 * server- and client-side sniffing both see the phone.
 *
 * `--flutter` captures a Flutter web build. Flutter renders the entire app
 * into ONE <canvas>: the DOM holds no text and no widgets, so a plain capture
 * works but `--selector` matches nothing and the agent is blind-clicking
 * pixels. This flag turns on Flutter's accessibility tree, which materializes
 * a real `<flt-semantics>` element per widget, and prints each one's label,
 * whether it is tappable, and its box. `--label=<text>` then frames one of
 * them, and the printed box is where to aim a `mouse.click` to drive the app
 * by name instead of by guessed pixel.
 *
 * `--console` also prints whatever the page logged and every uncaught error /
 * failed request, so one run answers both "how does it look" and "is it
 * broken". That pairing is the whole point: a page that renders fine and throws
 * in the console is the failure a screenshot alone reports as a pass.
 *
 * The outfile extension picks the format (.jpg/.jpeg → JPEG, else PNG).
 */
const path = require("node:path");

// playwright-core is installed globally in the image (API only — the browser is
// Debian's `chromium` package, at QA_CHROMIUM). Resolve it from the global
// module root rather than relative to this script — and lazily, so the pure
// label-matching below is requirable (and testable) off the image, where that
// global module root does not exist.
const GLOBAL_MODULES =
  process.env.QA_SCREENSHOT_MODULES || "/usr/local/lib/node_modules";
const chromium = () =>
  require(path.join(GLOBAL_MODULES, "playwright-core")).chromium;
const CHROMIUM_PATH = process.env.QA_CHROMIUM || "/usr/bin/chromium";

const MOBILE_USER_AGENT =
  "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) " +
  "AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1";

/**
 * Kept in lockstep with `MAX_SCREENSHOT_HEIGHT` / `DEVICE_VIEWPORTS` in
 * apps/api/src/harnesses/lib/decopilot/built-in-tools/portable-media-tools.ts —
 * the hosted `take_screenshot` and this must frame a page the same way, or a
 * before/after pair captured on different paths isn't comparable.
 *
 * The ceiling is not cosmetic: a capture over ~8000px on either side is
 * rejected outright when it reaches a model, so a full-page shot of a long page
 * has to be clipped. `clip` is CSS px while the image is CSS px × scale factor,
 * hence the division.
 */
const MAX_IMAGE_HEIGHT = 7000;

/** A page stuck in a logging loop would otherwise flood the agent's context. */
const MAX_CONSOLE_LINES = 200;

/**
 * How long to wait for a Flutter web build to mount its semantics placeholder
 * and then its tree. Generous because the cold path — wasm compile plus font
 * bootstrap on a sandbox with no warm cache — is the slow one, and this only
 * costs that long when the build genuinely never gets there.
 */
const FLUTTER_BOOT_TIMEOUT = 20000;

/** Cap the PRINTED widget list; the full list is still what `--label` matches
 *  against, and the count printed alongside says when it was cut. */
const MAX_SEMANTICS_LISTED = 60;
const DEVICES = {
  desktop: { viewport: { width: 1280, height: 800 }, deviceScaleFactor: 1 },
  mobile: {
    viewport: { width: 390, height: 844 },
    deviceScaleFactor: 2,
    isMobile: true,
    hasTouch: true,
    userAgent: MOBILE_USER_AGENT,
  },
};

/**
 * Scroll the whole page so lazy / IntersectionObserver-driven sections mount
 * before the capture — the fix for below-the-fold product shelves and images
 * that otherwise shoot as skeleton placeholders. Incremental steps (each
 * section enters the viewport and trips its observer), a short pause per step
 * for content to arrive, then back to the top. Bounded: stops when the page
 * stops growing and hard-caps the step count so an infinite-scroll page can't
 * loop forever. Runs entirely in the page, so it needs no network wait —
 * `networkidle` would hang on analytics beacons.
 */
async function settleLazyContent(page) {
  await page.evaluate(async () => {
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const vh = window.innerHeight || 800;
    let y = 0;
    for (let i = 0; i < 60; i++) {
      window.scrollTo(0, y);
      await sleep(250);
      const max = document.documentElement.scrollHeight - vh;
      if (y >= max) break;
      y = Math.min(y + Math.round(vh * 0.85), max);
    }
    window.scrollTo(0, document.documentElement.scrollHeight);
    await sleep(300);
    window.scrollTo(0, 0);
    await sleep(400);
  });
}

/**
 * Turn on Flutter web's accessibility tree and read it back.
 *
 * Flutter paints into a canvas, so until semantics are enabled the DOM has
 * nothing in it to select, assert on, or click by name. Flutter ships a hidden
 * `flt-semantics-placeholder` button for exactly this — assistive tech clicking
 * it is the signal to build the tree — and clicking it ourselves is the
 * supported way in.
 *
 * What comes back is NOT what an aria-shaped guess expects, so this reads the
 * DOM Flutter actually emits (verified against 3.41):
 *   <flt-semantics id="flt-semantic-node-8" role="button" flt-tappable
 *                  style="...; pointer-events: all; transform: matrix(...)">
 * There is no `aria-label` — the label is textContent — and the `id` is a
 * per-build counter, so neither an attribute selector nor an id is a stable
 * handle. The label is. Hence `--label`, and hence reporting the box: a
 * transparent overlay cannot be clicked through Playwright's actionability
 * checks, so a caller aims `mouse.click` at the box instead.
 *
 * Leaves only: a parent's textContent is its children's concatenated, which is
 * noise. Best-effort — a page that is not Flutter yields an empty list rather
 * than an error, since the screenshot is still the point.
 */
async function readFlutterSemantics(page) {
  // Wait for the placeholder rather than sleeping at it: a release web build
  // boots CanvasKit/skwasm and its fonts after `load`, and on a cold sandbox
  // that routinely outlasts any fixed pause — which would report "no semantics
  // tree" on a perfectly good build.
  // `attached`, not the default `visible` — the placeholder is deliberately
  // hidden, so a visibility wait would never resolve on any build.
  const placeholder = await page
    .waitForSelector("flt-semantics-placeholder", {
      state: "attached",
      timeout: FLUTTER_BOOT_TIMEOUT,
    })
    .catch(() => null);
  // No placeholder after all that is the answer: this is not a Flutter build.
  // Returning here keeps `--flutter` on a plain page at one wait, not two.
  if (!placeholder) return [];
  await page
    .evaluate(() => {
      const el = document.querySelector("flt-semantics-placeholder");
      if (el) el.click();
    })
    .catch(() => {});
  // Then for the tree the click builds. Same reason; an empty list after this
  // really is an empty list.
  await page
    .waitForFunction(
      () => document.querySelectorAll("flt-semantics").length > 0,
      undefined,
      { timeout: FLUTTER_BOOT_TIMEOUT },
    )
    .catch(() => {});
  return page
    .evaluate(() =>
      Array.from(document.querySelectorAll("flt-semantics"))
        .filter((n) => !n.querySelector("flt-semantics"))
        .map((n) => {
          const r = n.getBoundingClientRect();
          return {
            label: (n.textContent || "").trim(),
            tappable:
              n.hasAttribute("flt-tappable") ||
              n.getAttribute("role") === "button",
            box: {
              x: Math.round(r.x + window.scrollX),
              y: Math.round(r.y + window.scrollY),
              width: Math.round(r.width),
              height: Math.round(r.height),
            },
          };
        })
        .filter((n) => n.label && n.box.width > 0 && n.box.height > 0),
    )
    .catch(() => []);
}

/** One widget as a line: what to pass to `--label`, and where to click it. */
function describeNode(n) {
  return (
    `${n.tappable ? "[tap]" : "     "} ${JSON.stringify(n.label)} ` +
    `@ ${n.box.x},${n.box.y} ${n.box.width}x${n.box.height}`
  );
}

/** Exact label first, then unique case-insensitive substring. A label that
 *  matches several widgets is an ambiguous ask, and picking one silently would
 *  frame the wrong thing — so it reports the candidates instead. Duplicate
 *  EXACT labels are the common case in a real app (a row of "Delete" buttons,
 *  a tab bar, a repeated price), so they're ambiguous too. */
function findSemanticsByLabel(nodes, label) {
  const exact = nodes.filter((n) => n.label === label);
  if (exact.length === 1) return { node: exact[0] };
  if (exact.length > 1) return { ambiguous: exact };
  const needle = label.toLowerCase();
  const loose = nodes.filter((n) => n.label.toLowerCase().includes(needle));
  if (loose.length === 1) return { node: loose[0] };
  if (loose.length > 1) return { ambiguous: loose };
  return {};
}

async function main() {
  const args = process.argv.slice(2);
  const opts = {};
  const positional = [];
  for (const a of args) {
    if (a.startsWith("--")) {
      const [k, ...v] = a.slice(2).split("=");
      opts[k] = v.length ? v.join("=") : true;
    } else positional.push(a);
  }
  const [url, outfile] = positional;
  if (!url || !outfile) {
    console.error(
      "usage: qa-screenshot <url> <outfile> [--mobile] [--full] [--selector=<css>] [--console] [--flutter] [--label=<text>]",
    );
    process.exit(2);
  }
  const mobile = opts.mobile === true;
  const device = mobile ? DEVICES.mobile : DEVICES.desktop;
  const fullPage = opts.full === true;
  // Target a specific element (e.g. `--selector='[data-section=hero]'`) for a
  // focused before/after of just the affected component instead of the whole
  // page or the top viewport.
  const selector = typeof opts.selector === "string" ? opts.selector : null;
  const wantsConsole = opts.console === true;
  // Flutter-only: frame one widget from the semantics tree by its text.
  const label = typeof opts.label === "string" ? opts.label : null;
  // `--label` needs the semantics tree, which only `--flutter` builds. Imply it
  // rather than failing: without this the run reports "no semantics tree — is
  // this a Flutter web build?" and points the agent at the build instead of at
  // the missing flag.
  const flutter = opts.flutter === true || label !== null;
  const type = /\.jpe?g$/i.test(outfile) ? "jpeg" : "png";

  // --no-sandbox: the container drops all capabilities, so Chromium's own
  // setuid sandbox can't initialize; the pod is the isolation boundary here.
  //
  // CanvasKit needs WebGL, and a headless container has no GPU. Chromium's
  // automatic software fallback is deprecated and already warns; opting in
  // explicitly is what keeps a Flutter capture from going blank when that
  // fallback is finally removed.
  const browser = await chromium().launch({
    executablePath: CHROMIUM_PATH,
    args: flutter
      ? ["--no-sandbox", "--enable-unsafe-swiftshader"]
      : ["--no-sandbox"],
  });
  try {
    const context = await browser.newContext(device);
    const page = await context.newPage();
    // Wired before `goto` — load-time logs are the interesting ones, and a
    // listener attached after navigation has already missed them. Capped so a
    // page that logs in a loop can't blow up the caller's tool output.
    const logged = [];
    const record = (line) => {
      if (logged.length < MAX_CONSOLE_LINES) logged.push(line);
    };
    if (wantsConsole) {
      page.on("console", (m) => record(`[${m.type()}] ${m.text()}`));
      page.on("pageerror", (e) => record(`[uncaught] ${e.message}`));
      page.on("requestfailed", (r) =>
        record(
          `[requestfailed] ${r.url()} — ${r.failure()?.errorText ?? "unknown"}`,
        ),
      );
    }
    // `load` (not networkidle): analytics/beacons keep the network busy forever
    // on many sites, so networkidle hangs the capture.
    await page.goto(url, { waitUntil: "load", timeout: 45000 });
    // Give the page a beat to hydrate, then scroll through it so lazy /
    // below-the-fold sections actually mount instead of capturing as skeletons.
    await page.waitForTimeout(800);
    // A canvas app has no lazy DOM sections to scroll into view and a
    // scrollHeight that never exceeds the viewport, so the scroll pass is pure
    // latency there. It needs the semantics tree instead.
    let semantics = null;
    if (flutter) {
      semantics = await readFlutterSemantics(page);
    } else {
      await settleLazyContent(page);
    }

    // A full-page capture taller than the ceiling is truncated rather than
    // emitted oversized — an unusable image is worse than a partial one.
    //
    // Truncation grows the VIEWPORT to the ceiling and takes a viewport shot,
    // rather than passing `clip`: Playwright does not capture beyond the
    // viewport for a clip, so a clip taller than the viewport silently comes
    // back viewport-sized (measured: a 7000px clip on an 800px viewport yielded
    // 1280x800, and on a mobile context the width was wrong too). Resizing is
    // the only form that actually produces the requested pixels.
    let truncated = 0;
    if (label) {
      // A semantics node is an INVISIBLE overlay — correct geometry, zero
      // opacity, and often `pointer-events: none` — so Playwright's element
      // screenshot refuses it: `scrollIntoViewIfNeeded` and
      // `element.screenshot` both wait for a visibility that never arrives and
      // time out. Clip the page to the measured box instead; the pixels wanted
      // are the canvas underneath the overlay, which is exactly what a
      // page-level clip captures.
      const hit = findSemanticsByLabel(semantics ?? [], label);
      if (hit.ambiguous) {
        throw new Error(
          `--label ${JSON.stringify(label)} matches ${hit.ambiguous.length} widgets:\n` +
            hit.ambiguous.map((n) => `  ${describeNode(n)}`).join("\n") +
            `\nPass one of those labels exactly; if they are identical, they can ` +
            `only be told apart by position — aim mouse.click at the box you want.`,
        );
      }
      if (!hit.node) {
        // The list goes IN the error: the capture never happens, so the
        // usual listing below it never prints, and "check the list" would
        // point at nothing.
        const available = (semantics ?? []).map((n) => n.label);
        const listed = available.slice(0, MAX_SEMANTICS_LISTED);
        throw new Error(
          `--label ${JSON.stringify(label)} matched no widget. ` +
            (available.length
              ? `Available (${listed.length} of ${available.length}): ` +
                listed.map((l) => JSON.stringify(l)).join(", ") +
                (available.length > listed.length
                  ? `, … ${available.length - listed.length} more.`
                  : ".")
              : `No semantics tree built — is this a Flutter web build?`),
        );
      }
      // `fullPage: true` WITH the clip, not the clip alone: the box is in
      // document coordinates, and Flutter builds semantics for widgets outside
      // the viewport (a list's cacheExtent, anything below the fold). A bare
      // clip is trimmed to the viewport — the same measured limitation the
      // truncation branch below works around — so an off-screen widget would
      // come back empty or partial. With `fullPage` the clip is trimmed to the
      // document instead, which is where the box was measured.
      await page.screenshot({
        path: outfile,
        type,
        ...(type === "jpeg" ? { quality: 80 } : {}),
        fullPage: true,
        clip: hit.node.box,
      });
    } else if (selector) {
      // Just the targeted element: Playwright scrolls it into view and clips to
      // its bounding box, so `--full` and the height ceiling don't apply.
      const el = page.locator(selector).first();
      await el.scrollIntoViewIfNeeded({ timeout: 10000 });
      await el.screenshot({
        path: outfile,
        type,
        ...(type === "jpeg" ? { quality: 80 } : {}),
      });
    } else {
      if (fullPage) {
        const cssHeight = await page.evaluate(
          () => document.documentElement.scrollHeight,
        );
        const maxCss = Math.floor(MAX_IMAGE_HEIGHT / device.deviceScaleFactor);
        if (cssHeight > maxCss) {
          truncated = cssHeight - maxCss;
          await page.setViewportSize({
            width: device.viewport.width,
            height: maxCss,
          });
        }
      }
      await page.screenshot({
        path: outfile,
        type,
        ...(type === "jpeg" ? { quality: 80 } : {}),
        fullPage: fullPage && truncated === 0,
      });
    }

    const scale = `${device.viewport.width}x${device.viewport.height} @${device.deviceScaleFactor}x`;
    const framed = label
      ? `widget ${JSON.stringify(label)}`
      : selector
        ? `element ${selector}`
        : fullPage
        ? "full page"
        : "viewport";
    console.log(
      `saved ${outfile} (${mobile ? "mobile" : "desktop"} ${scale}, ${framed})` +
        (truncated
          ? `\nNOTE: clipped — ${truncated}px of page height omitted to stay under the ${MAX_IMAGE_HEIGHT}px image limit.`
          : ""),
    );
    if (semantics) {
      // Empty is a real answer worth printing: it means the tree never built,
      // so `--selector` will match nothing and the shot is all you get.
      const shown = semantics.slice(0, MAX_SEMANTICS_LISTED);
      console.log(
        semantics.length
          ? `\nflutter widgets (showing ${shown.length} of ${semantics.length}) — ` +
              `frame one with --label=<text>, click one by aiming mouse.click at ` +
              `its box centre:\n` +
              shown.map((n) => `  ${describeNode(n)}`).join("\n") +
              (semantics.length > shown.length
                ? `\n  … ${semantics.length - shown.length} more not listed — ` +
                  `--label still matches against all of them.`
                : "")
          : "\nflutter widgets: semantics tree did not build — is this a Flutter web build?",
      );
    }
    if (wantsConsole) {
      // "nothing" rather than silence: an empty section reads as a broken flag.
      console.log(
        logged.length
          ? `\nconsole (${logged.length}${logged.length === MAX_CONSOLE_LINES ? "+, truncated" : ""}):\n${logged.join("\n")}`
          : "\nconsole: no messages, errors, or failed requests.",
      );
    }
  } finally {
    await browser.close();
  }
}

// Only when run as a command — `require`ing this file gets the pure helper
// exported below without launching a browser.
if (require.main === module) {
  main().catch((err) => {
    console.error(`qa-screenshot failed: ${err?.message ?? err}`);
    process.exit(1);
  });
}

module.exports = { findSemanticsByLabel };
