{
  "name": "@decocms/sandbox",
  "version": "0.5.5",
  "type": "module",
  "description": "Sandbox runner for isolated per-user containerised tool execution",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build daemon/entry.ts --target=bun --outfile=daemon/dist/daemon.js --external node-pty",
    "dev:daemon": "bun run --watch daemon/entry.ts"
  },
  "exports": {
    "./shared": "./shared.ts",
    "./provider": "./server/provider/index.ts",
    "./provider/agent-sandbox": "./server/provider/agent-sandbox/index.ts",
    "./daemon-spawn": "./server/daemon-spawn.ts",
    "./provider/desktop": "./server/provider/desktop/index.ts",
    "./daemon-client": "./server/daemon-client.ts",
    "./daemon/routes/dispatch": "./daemon/routes/dispatch.ts"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@opentelemetry/api": "^1.9.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
