{
  "name": "@decocms/sandbox",
  "version": "1.37.0",
  "private": true,
  "type": "module",
  "description": "Sandbox runtime for isolated Studio tool execution",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run build:typegen && bun run build:harness-runner",
    "build:typegen": "mkdir -p dist && bun run --cwd=../typegen build && bun --cwd=../typegen pm pack --filename $PWD/dist/typegen.tgz --quiet",
    "build:harness-runner": "mkdir -p dist && bun --cwd=../harness-runner pm pack --filename $PWD/dist/harness-runner.tgz --quiet"
  },
  "exports": {
    "./shared": "./shared.ts",
    "./provider": "./server/provider/index.ts",
    "./provider/agent-sandbox": "./server/provider/agent-sandbox/index.ts",
    "./daemon-client": "./server/daemon-client.ts",
    "./org-fs": "./org-fs.ts",
    "./dispatch": "./dispatch/index.ts",
    "./dispatch/*": "./dispatch/*.ts",
    "./proxy/http": "./proxy/http.ts",
    "./proxy/websocket": "./proxy/websocket.ts"
  },
  "dependencies": {
    "@decocms/shared": "workspace:*",
    "@kubernetes/client-node": "^1.4.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/nats-core": "3.4.0",
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  }
}
