#!/usr/bin/env bash
# qa-app — run a REAL Flutter app headlessly and drive it.
#
#   qa-app start [-t lib/main.dart] [--size 390x844]
#   qa-app shot <out.png>    qa-app click <x> <y>    qa-app type "text"
#   qa-app key Return        qa-app logs [n]         qa-app stop
#
# `flutter build web` is the only way the standard sandbox image can look at a
# Flutter UI, and a repo whose dependency graph does not compile to JS has no
# way at all. The Linux desktop target is native, so those blockers do not
# apply, and it runs the app's real main() rather than a widget in isolation.
#
# Coordinates are read off the screenshot: same X display, same pixels, 1:1
# with `click`. There is no semantics tree to consult and none is needed — on
# the web build the DOM is one opaque <canvas>, which is why qa-screenshot has
# `--flutter`; here the picture IS the map.
set -euo pipefail

DISPLAY_NUM="${QA_DISPLAY:-:99}"
# /tmp is the pod's writable tmpfs; the rootfs is read-only.
STATE="${TMPDIR:-/tmp}/qa-app"
export DISPLAY="$DISPLAY_NUM"

die() { echo "qa-app: $*" >&2; exit 1; }

# The GTK runner's window is 1280x720 by default. Resizing it after launch
# beats patching linux/runner/my_application.cc in every repo, and leaves
# nothing behind to accidentally commit.
frame_window() {
  local size=$1 w=${1%x*} h=${1#*x} id
  for _ in $(seq 1 600); do
    id=$(xdotool search --onlyvisible --name . 2>/dev/null | tail -1 || true)
    if [ -n "$id" ]; then
      xdotool windowsize "$id" "$w" "$h" windowmove "$id" 0 0
      return 0
    fi
    sleep 0.5
  done
  return 1
}

cmd_start() {
  local target="" size=390x844
  while [ $# -gt 0 ]; do
    case $1 in
      -t) target=${2:?-t needs a path}; shift 2 ;;
      --size) size=${2:?--size needs WxH}; shift 2 ;;
      *) die "unknown flag $1" ;;
    esac
  done
  [[ $size =~ ^[0-9]+x[0-9]+$ ]] || die "--size must look like 390x844"
  [ -f pubspec.yaml ] || die "no pubspec.yaml in $PWD — run this from the Flutter app root"

  mkdir -p "$STATE"
  # A repo targeting only android/ios/web has no linux runner. The daemon
  # checkpoints the working tree to the branch every couple of minutes, so the
  # runner is generated in a scratch project and only linux/ is copied in —
  # `flutter create .` would also rewrite .metadata and add template files —
  # then excluded via git's own paths, which hold for a subdirectory app and a
  # worktree alike.
  if [ ! -d linux ]; then
    echo "qa-app: generating linux/ runner (excluded from git)"
    local name scratch
    name=$(sed -n 's/^name:[[:space:]]*\([A-Za-z0-9_]*\).*/\1/p' pubspec.yaml | head -1)
    [ -n "$name" ] || die "could not read the package name from pubspec.yaml"
    scratch=$(mktemp -d)
    flutter create --platforms=linux --project-name "$name" "$scratch/app" >/dev/null
    cp -R "$scratch/app/linux" linux
    rm -rf "$scratch"
    if git rev-parse --git-dir >/dev/null 2>&1; then
      local exclude pattern
      exclude=$(git rev-parse --git-path info/exclude)
      pattern="/$(git rev-parse --show-prefix)linux/"
      mkdir -p "$(dirname "$exclude")"
      grep -qxF "$pattern" "$exclude" 2>/dev/null || echo "$pattern" >> "$exclude"
    fi
  fi

  cmd_stop >/dev/null 2>&1 || true
  # Xvfb wants this to exist; under a read-only rootfs /tmp is the tmpfs mount.
  mkdir -p /tmp/.X11-unix 2>/dev/null || true
  # A server killed without cleaning up leaves its lock behind, and Xvfb then
  # refuses the display forever ("Server is already active"). Nothing else in
  # the pod owns this display, so a lock with no live server is always stale.
  if ! xdpyinfo >/dev/null 2>&1; then
    rm -f "/tmp/.X${DISPLAY_NUM#:}-lock" 2>/dev/null || true
  fi
  Xvfb "$DISPLAY_NUM" -screen 0 "${size}x24" -nolisten tcp \
    >"$STATE/xvfb.log" 2>&1 &
  echo $! > "$STATE/xvfb.pid"
  for _ in $(seq 1 40); do xdpyinfo >/dev/null 2>&1 && break; sleep 0.25; done
  xdpyinfo >/dev/null 2>&1 || die "Xvfb did not start; see $STATE/xvfb.log"

  : > "$STATE/app.log"
  # `flutter run` rather than `build` + exec: it streams the runtime errors
  # that decide whether an app is drivable here at all. A plugin with no Linux
  # implementation compiles fine and throws MissingPluginException on first
  # call, so the log is the only place that failure is visible.
  setsid flutter run -d linux ${target:+-t "$target"} \
    >>"$STATE/app.log" 2>&1 < /dev/null &
  echo $! > "$STATE/app.pid"

  echo "qa-app: building and launching — first build is slow; tail $STATE/app.log"
  frame_window "$size" || die "no window appeared. Last 40 log lines:
$(tail -40 "$STATE/app.log" 2>/dev/null)"
  sleep 2   # the first frame lands after the window maps
  echo "qa-app: window up at $size"
}

cmd_stop() {
  [ -f "$STATE/app.pid" ] && kill -- -"$(cat "$STATE/app.pid")" 2>/dev/null || true
  [ -f "$STATE/xvfb.pid" ] && kill "$(cat "$STATE/xvfb.pid")" 2>/dev/null || true
  rm -f "$STATE/app.pid" "$STATE/xvfb.pid" "/tmp/.X${DISPLAY_NUM#:}-lock"
  echo "qa-app: stopped"
}

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  shot)  shift; out=${1:?usage: qa-app shot <out.png>}
         mkdir -p "$(dirname "$out")"; import -window root "$out"; echo "$out" ;;
  click) shift; xdotool mousemove "${1:?x}" "${2:?y}" click 1 ;;
  type)  shift; xdotool type --delay 40 "$*" ;;
  key)   shift; xdotool key "$@" ;;
  logs)  tail -n "${2:-60}" "$STATE/app.log" ;;
  stop)  cmd_stop ;;
  *) sed -n '3,8p' "$0" | sed 's/^# \?//'; exit 1 ;;
esac
