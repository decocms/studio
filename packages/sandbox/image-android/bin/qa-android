#!/usr/bin/env bash
# qa-android — boot an Android emulator, run the app on it, and drive it.
#
#   qa-android start [-t lib/main.dart]   qa-android wait
#   qa-android shot <out.png>             qa-android ui
#   qa-android tap <x> <y>                qa-android swipe <x1> <y1> <x2> <y2> [ms]
#   qa-android type "text"                qa-android key BACK|ENTER|HOME|...
#   qa-android logs [n]                   qa-android stop
#
# `start` builds the app from the current directory, then boots a headless
# emulator (KVM required) and `flutter run`s the build onto it: install,
# launch, and a live log of the app's output. Everything after that is
# adb. The work runs detached, and `start` waits for it for at most
# QA_ANDROID_WAIT seconds (default 540, under an agent's 10-minute tool limit):
# exit 0 means the app is up, 1 that it failed, 2 that it is still going and
# `qa-android wait` picks the wait back up.
#
# Coordinates are screenshot pixels: the display is 720x1600 and `shot`
# captures it 1:1, so a point read off the PNG is exactly what `tap` takes.
# `ui` lists the on-screen elements Android's accessibility layer sees — for a
# Flutter app that is its Semantics tree — with the centre of each, which beats
# guessing a button's position from the picture.
set -euo pipefail
[ -n "${QA_ANDROID_TRACE:-}" ] && set -x

STATE="${TMPDIR:-/tmp}/qa-android"
SERIAL=emulator-5554
AVD=qa
SYSTEM_IMAGE="system-images;android-36;google_apis;x86_64"
export ANDROID_AVD_HOME="${ANDROID_AVD_HOME:-$HOME/.android/avd}"
AVD_DIR="$ANDROID_AVD_HOME/$AVD.avd"
# Node-local and shared by every sandbox on the node — the same trust model as
# the daemon's own caches under DEPS_CACHE_ROOT. Unset: everything stays in the pod.
CACHE="${DEPS_CACHE_ROOT:+$DEPS_CACHE_ROOT/android}"

die() { echo "qa-android: $*" >&2; exit 1; }
adb_() { adb -s "$SERIAL" "$@"; }
booted() { adb_ shell getprop sys.boot_completed 2>/dev/null | grep -q 1; }

# A booted AVD is only reusable by the exact script, emulator and system image
# that made it.
snapshot_cache() {
  [ -n "$CACHE" ] || return 0
  local sum
  sum=$(cat "$0" "$ANDROID_HOME/emulator/source.properties" \
    "$ANDROID_HOME/${SYSTEM_IMAGE//;//}/source.properties" 2>/dev/null | sha256sum) || return 0
  echo "$CACHE/avd/${sum:0:16}"
}

ensure_avd() {
  [ -d "$AVD_DIR" ] && return 0
  mkdir -p "$ANDROID_AVD_HOME"
  local snap; snap=$(snapshot_cache)
  if [ -n "$snap" ] && [ -d "$snap/$AVD.avd" ] \
    && cp -a --reflink=auto "$snap/$AVD.avd" "$snap/$AVD.ini" "$ANDROID_AVD_HOME/"; then
    return 0
  fi
  rm -rf "$AVD_DIR"
  echo no | avdmanager create avd -n "$AVD" -k "$SYSTEM_IMAGE" --force >/dev/null
  # A modest, fixed display keeps screenshots small enough to read and makes
  # coordinates stable across runs.
  cat >> "$AVD_DIR/config.ini" <<'EOF'
hw.lcd.width=720
hw.lcd.height=1600
hw.lcd.density=320
hw.ramSize=3072
hw.keyboard=yes
disk.dataPartition.size=3G
showDeviceFrame=no
EOF
}

launch_emulator() {
  setsid emulator -avd "$AVD" -port 5554 -no-window -no-audio -no-boot-anim \
    -no-snapshot-save -no-metrics -gpu swiftshader_indirect -accel on \
    -memory 3072 -cores "${QA_ANDROID_CORES:-4}" "$@" \
    >"$STATE/emulator.log" 2>&1 < /dev/null &
  echo $! > "$STATE/emulator.pid"
  adb start-server >/dev/null
}

wait_boot() {
  for _ in $(seq 1 300); do
    kill -0 "$(cat "$STATE/emulator.pid")" 2>/dev/null || return 1
    booted && return 0
    sleep 1
  done
  return 1
}

kill_emulator() {
  adb_ emu kill >/dev/null 2>&1 || true
  local pid; pid=$(cat "$STATE/emulator.pid" 2>/dev/null) || return 0
  for _ in $(seq 1 30); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
  kill -- -"$pid" 2>/dev/null || true
  rm -f "$STATE/emulator.pid"
}

# The first sandbox on a node cold-boots, saves the booted state and publishes
# the AVD; every later one copies it (a reflink where the filesystem allows)
# and resumes from that snapshot instead of booting Android again.
publish_snapshot() {
  local snap; snap=$(snapshot_cache)
  [ -n "$snap" ] && [ ! -d "$snap" ] || return 0
  adb_ emu avd snapshot save boot >/dev/null 2>&1 || return 0
  # Copy a stopped AVD: the running emulator keeps writing its disk images.
  kill_emulator
  mkdir -p "$snap.$$"
  if cp -a --reflink=auto "$AVD_DIR" "$ANDROID_AVD_HOME/$AVD.ini" "$snap.$$/"; then
    mv -T "$snap.$$" "$snap" 2>/dev/null || true
  fi
  rm -rf "$snap.$$"
  # ponytail: keeps one snapshot per node; each qa-android or SDK change replaces it.
  find "$(dirname "$snap")" -mindepth 1 -maxdepth 1 ! -name "$(basename "$snap")*" \
    -exec rm -rf {} + 2>/dev/null || true
}

prepare_emulator() {
  booted && return 0
  [ -r /dev/kvm ] && [ -w /dev/kvm ] \
    || die "/dev/kvm is not available to this sandbox, so the emulator cannot run. This repo needs the Android sandbox image on a KVM node; report that rather than retrying."
  ensure_avd
  if [ -d "$AVD_DIR/snapshots/boot" ]; then
    echo "qa-android: resuming the emulator from its boot snapshot"
    launch_emulator -snapshot boot
    wait_boot || { kill_emulator; rm -rf "$AVD_DIR/snapshots/boot"; }
  fi
  if ! booted; then
    echo "qa-android: cold-booting the emulator"
    launch_emulator -no-snapshot-load
    wait_boot || die "emulator did not boot. Last 40 log lines:
$(tail -40 "$STATE/emulator.log")"
    publish_snapshot
    if ! booted; then
      launch_emulator -snapshot boot
      wait_boot || { kill_emulator; launch_emulator -no-snapshot-load; wait_boot; } \
        || die "emulator did not boot. Last 40 log lines:
$(tail -40 "$STATE/emulator.log")"
    fi
  fi
  # Animations make a screenshot taken right after a tap catch a transition
  # instead of the result.
  for s in window_animation_scale transition_animation_scale animator_duration_scale; do
    adb_ shell settings put global "$s" 0
  done
  adb_ shell svc power stayon true
  adb_ shell input keyevent KEYCODE_WAKEUP
  adb_ shell wm dismiss-keyguard >/dev/null 2>&1 || true
  echo "qa-android: emulator booted"
}

# The daemon checkpoints the working tree to the branch, and a repo's
# .gitignore may not cover everything a local Gradle build writes.
exclude_build_output() {
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  local exclude prefix p
  exclude=$(git rev-parse --git-path info/exclude)
  prefix="/$(git rev-parse --show-prefix)"
  mkdir -p "$(dirname "$exclude")"
  for p in build/ .dart_tool/ android/.gradle/ android/.kotlin/ android/local.properties android/app/.cxx/; do
    grep -qxF "$prefix$p" "$exclude" 2>/dev/null || echo "$prefix$p" >> "$exclude"
  done
}

# User-home gradle.properties overrides the project's. Flutter's template asks
# for -Xmx8G plus a separate Kotlin daemon, which with the emulator alongside
# overruns the pod's memory.
cap_gradle() {
  local f="${GRADLE_USER_HOME:-$HOME/.gradle}/gradle.properties"
  [ -f "$f" ] && return 0
  mkdir -p "$(dirname "$f")"
  cat > "$f" <<'EOF'
org.gradle.jvmargs=-Xmx4g -XX:MaxMetaspaceSize=1g -XX:+UseParallelGC
org.gradle.workers.max=2
org.gradle.daemon.idletimeout=600000
org.gradle.caching=true
kotlin.compiler.execution.strategy=in-process
EOF
}

# Per repository, so a pod's first build downloads and compiles only what no
# earlier pod on this node already did. Credentials are stripped so a rotated
# token keeps the key.
# ponytail: two pods of one repo on one node share the dir; Gradle's file locks
# serialize them, and its cross-process release ping does not cross pods, so the
# second can wait up to Gradle's lock timeout.
share_gradle_cache() {
  [ -n "$CACHE" ] || return 0
  local url key g d
  g="${GRADLE_USER_HOME:-$HOME/.gradle}"
  # The daemon links these itself after seeding the node's cache from the
  # shared store (setup/androidgradle.go); linking first would bypass that.
  for _ in $(seq 1 180); do [ -e "$g/.studio-cache-restoring" ] || break; sleep 1; done
  url=$(git remote get-url origin 2>/dev/null) || return 0
  key=$(printf '%s' "$url" | sed -E 's#//[^@/]*@#//#' | sha256sum | cut -c1-16)
  mkdir -p "$g"
  for d in caches wrapper; do
    mkdir -p "$CACHE/gradle/$key/$d"
    [ -e "$g/$d" ] || ln -s "$CACHE/gradle/$key/$d" "$g/$d"
  done
  if [ ! -e /tmp/flutter-gradle ]; then
    mkdir -p "$CACHE/flutter-gradle/$key"
    ln -s "$CACHE/flutter-gradle/$key" /tmp/flutter-gradle
  fi
}

# Gradle's own failure report out of a verbose flutter log, or its tail.
gradle_error() {
  local report
  report=$(sed -n '/What went wrong/,/\* Try:/p' "$1" | sed 's/^\[[^]]*\] //' | head -40)
  [ -n "$report" ] || report=$(grep -E "FAILURE|rror|xception|denied|[Rr]ead-only" "$1" \
    | grep -v -E "^\s+#[0-9]|<asynchronous" | head -40)
  [ -n "$report" ] && echo "$report" || tail -40 "$1"
}

# Runs detached; its exit status lands in $STATE/status for `wait` to read.
run_start() {
  local target=${1:-}
  trap 'echo $? > "$STATE/status"' EXIT
  exclude_build_output
  cap_gradle
  share_gradle_cache
  stop_app
  kill_emulator
  # Build first, verbosely: without -v, flutter reduces any Gradle failure to
  # "assembleDebug failed".
  echo "qa-android: building — a first Gradle build takes minutes"
  mkdir -p /tmp/flutter-gradle/dot-gradle /tmp/flutter-gradle/build /tmp/flutter-gradle/kotlin
  flutter build apk --debug --target-platform android-x64 -v ${target:+-t "$target"} >"$STATE/build.log" 2>&1 \
    || die "the Android build failed (full log: $STATE/build.log):
$(gradle_error "$STATE/build.log")"
  echo "qa-android: built"
  # The Gradle daemon and the emulator each take ~5G and together overrun the
  # pod's memory, so they never run at once: `flutter run` installs this APK
  # instead of calling Gradle again.
  (cd android && ./gradlew --stop) >/dev/null 2>&1 || true
  prepare_emulator
  : > "$STATE/app.log"
  # `flutter run` rather than adb install: it streams the app's own output,
  # which is where a crash on startup shows up.
  setsid flutter run -d "$SERIAL" ${target:+-t "$target"} \
    --use-application-binary build/app/outputs/flutter-apk/app-debug.apk \
    >>"$STATE/app.log" 2>&1 < /dev/null &
  echo $! > "$STATE/app.pid"
  echo "qa-android: installing and launching; tail $STATE/app.log"
  for _ in $(seq 1 600); do
    grep -q "Flutter run key commands" "$STATE/app.log" && break
    kill -0 "$(cat "$STATE/app.pid")" 2>/dev/null \
      || die "flutter run exited. Last 60 log lines:
$(tail -60 "$STATE/app.log")"
    sleep 1
  done
  grep -q "Flutter run key commands" "$STATE/app.log" \
    || die "the app did not launch in 10 minutes; see $STATE/app.log"
  sleep 3   # first frame
  echo "qa-android: app running on $SERIAL (720x1600)"
}

start_running() { kill -0 "$(cat "$STATE/start.pid" 2>/dev/null)" 2>/dev/null; }

cmd_start() {
  local target=""
  while [ $# -gt 0 ]; do
    case $1 in
      -t) target=${2:?-t needs a path}; shift 2 ;;
      *) die "unknown flag $1" ;;
    esac
  done
  [ -f pubspec.yaml ] || die "no pubspec.yaml in $PWD — run this from the Flutter app root"
  [ -d android ] || die "no android/ project here, so there is nothing to run on the emulator"
  mkdir -p "$STATE"
  if start_running; then
    echo "qa-android: a start is already in progress; waiting for it"
  else
    rm -f "$STATE/status"
    setsid "$0" _run "$target" > "$STATE/start.log" 2>&1 < /dev/null &
    echo $! > "$STATE/start.pid"
  fi
  cmd_wait
}

cmd_wait() {
  [ -f "$STATE/start.pid" ] || die "nothing to wait for — run \`qa-android start\` first"
  local shown=0 n
  for _ in $(seq 1 "${QA_ANDROID_WAIT:-540}"); do
    n=$(wc -l < "$STATE/start.log")
    [ "$n" -gt "$shown" ] && { sed -n "$((shown + 1)),${n}p" "$STATE/start.log"; shown=$n; }
    if [ -f "$STATE/status" ]; then
      sed -n "$((shown + 1)),\$p" "$STATE/start.log"
      exit "$(( $(cat "$STATE/status") == 0 ? 0 : 1 ))"
    fi
    start_running || { sed -n "$((shown + 1)),\$p" "$STATE/start.log"; die "start exited without a result"; }
    sleep 1
  done
  echo "qa-android: still working — run \`qa-android wait\` to keep waiting"
  exit 2
}

cmd_ui() {
  adb_ shell uiautomator dump /sdcard/qa-ui.xml >/dev/null
  adb_ exec-out cat /sdcard/qa-ui.xml | python3 -c '
import re, sys
import xml.etree.ElementTree as ET
for n in ET.parse(sys.stdin).iter("node"):
    label = n.get("text") or n.get("content-desc")
    if not label:
        continue
    x1, y1, x2, y2 = map(int, re.findall(r"\d+", n.get("bounds")))
    flags = " clickable" if n.get("clickable") == "true" else ""
    print(f"{(x1 + x2) // 2},{(y1 + y2) // 2}{flags}\t{label}")
'
}

stop_app() {
  [ -f "$STATE/app.pid" ] && kill -- -"$(cat "$STATE/app.pid")" 2>/dev/null || true
  rm -f "$STATE/app.pid"
}

cmd_stop() {
  start_running && kill -- -"$(cat "$STATE/start.pid")" 2>/dev/null || true
  stop_app
  kill_emulator
  echo "qa-android: stopped"
}

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  wait)  cmd_wait ;;
  _run)  shift; run_start "$@" ;;
  shot)  shift; out=${1:?usage: qa-android shot <out.png>}
         mkdir -p "$(dirname "$out")"; adb_ exec-out screencap -p > "$out"; echo "$out" ;;
  ui)    cmd_ui ;;
  tap)   shift; adb_ shell input tap "${1:?x}" "${2:?y}" ;;
  swipe) shift; adb_ shell input swipe "${1:?x1}" "${2:?y1}" "${3:?x2}" "${4:?y2}" "${5:-300}" ;;
  # `input text` takes %s for a space and runs through the device shell.
  type)  shift; text="$*"; adb_ shell input text "$(printf '%q' "${text// /%s}")" ;;
  key)   shift; k=${1:?key}; [[ $k =~ ^[0-9]+$|^KEYCODE_ ]] || k="KEYCODE_$k"
         adb_ shell input keyevent "$k" ;;
  logs)  tail -n "${2:-60}" "$STATE/app.log" ;;
  stop)  cmd_stop ;;
  *) sed -n '3,9p' "$0" | sed 's/^# \?//'; exit 1 ;;
esac
