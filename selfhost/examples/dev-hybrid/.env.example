# dev-hybrid env — the Studio API (apps/api/src/index.ts) run from source on
# the host, pointed at the LOCAL cluster's backends and sandbox. dev-hybrid.sh
# port-forwards the cluster Services to these localhost ports, exports this file,
# and runs the raw dev servers (Vite + src/index.ts) — NOT `bun run dev` (that
# one is the embedded orchestrator that ignores these targets).
#
# On first run the script copies this to `.env` (same folder); edit that copy.

# ── Backends (port-forwarded from the cluster by dev-hybrid.sh) ──────────────
# Match the umbrella's dev deps: studio-db (user/db "studio"), studio-minio,
# and the chart's NATS. The ports are the local ends of the port-forwards.
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=studio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── Sandbox (driven in the cluster via your kubeconfig) ──────────────────────
# The token MUST equal the umbrella's sandbox-env.sentinel.token so Studio runs in
# warm-pool mode (otherwise claims are rejected — see the skill's troubleshooting).
STUDIO_AGENT_SANDBOX_ENABLED=true
STUDIO_ENV=local
STUDIO_SANDBOX_TEMPLATE_NAME=studio-sandbox-local
STUDIO_SANDBOX_SENTINEL_TOKEN=local-dev-sandbox-sentinel-token-change-me
# Best-effort preview in dev (Studio in-process proxy). Match the port to VITE_PORT.
STUDIO_SANDBOX_PREVIEW_URL_PATTERN=http://{handle}.preview.localhost:4000

# ── App ──────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:4000
BETTER_AUTH_URL=http://localhost:4000
# Dev fixtures — stable across restarts. Change for anything shared.
ENCRYPTION_KEY=local-dev-encryption-key-change-me
BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me

# CLICKHOUSE_URL intentionally unset → bun dev uses its local DuckDB/NDJSON
# monitoring path (no in-cluster ClickHouse needed for the hybrid). To point at
# an in-cluster ClickHouse instead, port-forward it and set CLICKHOUSE_URL here.
