# Copy to `.env` (same folder) and edit. Every value has a dev default in the
# canonical compose, so an empty .env already boots. Set real values for
# anything reachable by others.

# ── Image ──────────────────────────────────────────────────────────────────
IMAGE_REPOSITORY=ghcr.io/decocms/studio/studio
IMAGE_TAG=latest

# ── Ports / URLs ─────────────────────────────────────────────────────────────
PORT=3000
BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
MINIO_CONSOLE_PORT=9001

# ── Secrets (MUST be stable across restarts; change for anything shared) ──────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=local-dev-better-auth-secret-change-me
ENCRYPTION_KEY=local-dev-encryption-key-change-me

# ── PostgreSQL (bundled) ─────────────────────────────────────────────────────
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio

# ── Object storage / MinIO (bundled) ─────────────────────────────────────────
S3_BUCKET=studio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── Auth providers (optional; uncomment in the compose to enable) ─────────────
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# --- Git providers (repositories, sandbox clones, task board) -----------------
# Optional. Without these, connecting a repository through Studio is disabled
# (the API answers 503) and existing mcp-github connections keep working.
#
# GitHub: register a GitHub App, grant it Contents/Pull requests/Issues (write)
# and Checks/Deployments/Metadata (read), and set its callback URL to
# <PUBLIC_URL>/api/_git/github/callback and its setup URL to
# <PUBLIC_URL>/api/_git/github/setup.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=          # PEM; \n escapes are accepted on one line
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_SLUG=                 # the app's URL slug, for the install link
#
# GitLab: register an OAuth application (scopes: api, read_user) with callback
# <PUBLIC_URL>/api/_git/gitlab/callback. One application per instance, so
# self-managed hosts other than GITLAB_OAUTH_HOST connect with an access token
# instead (GIT_ACCOUNT_CONNECT_TOKEN).
# GITLAB_OAUTH_HOST=gitlab.com
# GITLAB_OAUTH_CLIENT_ID=
# GITLAB_OAUTH_CLIENT_SECRET=
