FROM oven/bun:1-slim

# unzip + bash are runtime dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends unzip bash && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy everything and install
COPY . .
RUN bun install

# Build both apps and stage the web assets into the API distribution.
RUN bun run build:studio

WORKDIR /app/apps/api

RUN mkdir -p /app/data

# Create entrypoint that runs migrations then starts server via CLI
RUN printf '#!/bin/bash\nset -e\ncd /app/apps/api\necho "Running migrations..."\nbun run migrate 2>&1\necho "Starting server..."\nexec bun run src/cli.ts --no-tui\n' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 3000

ENV NODE_ENV=production

CMD ["/app/entrypoint.sh"]
