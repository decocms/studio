FROM oven/bun:1-slim

# unzip + bash are runtime dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends unzip bash && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy everything and install
COPY . .
RUN bun install

# Build both apps and stage the web assets into the API distribution.
RUN bun run build:studio

WORKDIR /app/apps/api

RUN mkdir -p /app/data

EXPOSE 3000

ENV NODE_ENV=production

CMD ["bun", "run", "src/index.ts"]
