  "version": "4.97.0",
  "description": "Deco CMS — Self-hostable MCP Gateway for managing AI connections and tools",
  "author": "Deco team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decocms/studio.git",
    "directory": "apps/mesh"
