{
  "name": "@decocms/studio",
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/bun": "^1.3.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "knip": "^5.83.1",
    "oxlint": "1.23.0",
    "react": "^19.2.6",
    "typescript": "^5.9.3",
    "worktree-devservers": "0.3.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "scripts": {
    "dev": "bun run --env-file=.env scripts/dev.ts",
    "dev:servers": "concurrently -k -n api,web \"bun run --cwd=apps/api dev:server\" \"bun run --cwd=apps/web dev\"",
    "dev:api": "bun run --cwd=apps/api dev",
    "dev:web": "bun run --cwd=apps/web dev",
    "dev:worktree": "bun run scripts/dev-worktree.ts",
    "dev:conductor": "WORKTREE_SLUG=$CONDUCTOR_WORKSPACE_NAME bun run dev:worktree -- --local-sandbox-provider --hot",
    "fmt": "biome format --write",
    "lint": "oxlint",
    "check": "bun run check:readmes && bun run --workspaces check",
    "check:ci": "bun run check",
    "check:readmes": "bun run scripts/check-workspace-readmes.ts",
    "fmt:check": "biome format",
    "test": "bun run scripts/test-unit.ts",
    "docs:dev": "bun run --cwd=apps/docs dev",
    "docs:deploy": "bun run --cwd=apps/docs deploy",
    "build:runtime": "bun run --filter=@decocms/runtime build",
    "build:api": "bun run --cwd=apps/api build:server",
    "build:web": "bun run --cwd=apps/web build",
    "build:studio": "bun run scripts/build-studio.ts",
    "ui": "npx shadcn@latest add -c ./packages/ui",
    "clean": "rm -f deno.lock package-lock.json bun.lock && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "exorcise": "bun run clean && bun install --force",
    "knip": "knip",
    "services:up": "bun run --env-file apps/api/.env apps/api/src/cli.ts services up",
    "services:down": "bun run --env-file apps/api/.env apps/api/src/cli.ts services down",
    "services:status": "bun run --env-file apps/api/.env apps/api/src/cli.ts services status"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@duckdb/node-api",
    "@duckdb/node-bindings",
    "node-pty"
  ],
  "overrides": {
    "@openai/codex": "0.144.3",
    "fast-xml-parser": "5.4.2",
    "@anthropic-ai/claude-agent-sdk": "0.3.181"
  }
}
